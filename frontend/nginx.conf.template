# Rendered by the nginx image's envsubst entrypoint: ${API_UPSTREAM} is the
# API host:port (compose: api:8080, Kubernetes: <release>-api:8080).
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA: every non-file route falls back to index.html
    location / {
        try_files $uri /index.html;
    }

    # Proxy the API
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 100m;  # report verification uploads
    }

    location /healthz {
        proxy_pass http://${API_UPSTREAM};
    }
}
