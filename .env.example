# Forensic Wace configuration — copy to .env and adjust.
# Every FW_* variable maps to a field in forensicwace_core.config.Settings.
# NEVER commit the real .env file.

# --- Results database (PostgreSQL) -----------------------------------------
FW_DATABASE_URL=postgresql+psycopg2://forensicwace:forensicwace@localhost:5432/forensic_wace

# --- Message broker (RabbitMQ) -------------------------------------------------
# When set, analysis jobs run on the Celery workers (services/worker) and
# survive API restarts. When unset, the API runs them in a background thread.
# FW_BROKER_URL=amqp://guest:guest@localhost:5672//

# --- Evidence storage --------------------------------------------------------
# Backups are read from ${FW_DATA_DIR}/device_extractions_IOS and
# ${FW_DATA_DIR}/device_extractions_Android unless overridden explicitly.
FW_DATA_DIR=data
# Override the single directories if your extractions live elsewhere:
# FW_IOS_EXTRACTIONS_DIR=D:/cases/case42/device_extractions_IOS
# FW_ANDROID_EXTRACTIONS_DIR=D:/cases/case42/device_extractions_Android

# --- Report generation --------------------------------------------------------
# Logo/icons for PDFs and analyzer-check fixtures (optional).
FW_ASSETS_DIR=assets
# RFC 3161 trusted timestamping
FW_TSA_URL=https://freetsa.org/tsr
FW_TSA_CERTIFICATE_FILE=assets/reportCertificate/tsa.crt

# --- Local analyzer sidecars (Docker) ----------------------------------------
# FW_DEEPPASS_ENDPOINT=http://localhost:5000
# FW_WHISPER_ENDPOINT=http://localhost:9000/asr
# FW_TESSERACT_ENDPOINT=http://localhost:7865/v1/ocr
# FW_LAVIS_ENDPOINT=http://localhost:7866

# --- Presidio ------------------------------------------------------------------
FW_PRESIDIO_RECOGNIZERS_FILE=assets/presidio_recognizers/recognizers.yaml

# --- HuggingFace (StarPII) ------------------------------------------------------
# FW_HF_TOKEN=hf_...

# --- OpenAI ----------------------------------------------------------------------
# FW_OPENAI_API_KEY=sk-proj-...
# FW_OPENAI_ASSISTANT_ID=asst_...
# FW_USE_OPENAI_GPT=true

# --- Microsoft Azure ---------------------------------------------------------------
# FW_MS_PII_ENDPOINT=https://YOUR_REGION.cognitiveservices.azure.com/
# FW_MS_PII_KEY=...
# FW_USE_MS_PII=true
# FW_MS_S2T_KEY=...
# FW_MS_S2T_REGION=eastus
# FW_MS_S2T_LANGUAGE=en-US
# FW_USE_MS_S2T=true
# FW_MS_CV_ENDPOINT=https://YOUR_REGION.cognitiveservices.azure.com/
# FW_MS_CV_KEY=...
# FW_MS_CV_LANGUAGE=en
# FW_USE_MS_OCR_CAPTION=true

# --- docker-compose only ---------------------------------------------------------
# POSTGRES_USER=forensicwace
# POSTGRES_PASSWORD=forensicwace
# POSTGRES_DB=forensic_wace
# CORE_EXTRAS=postgres,presidio,azure,openai
